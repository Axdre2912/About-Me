# Copy to .env and fill in values

# Local SQLite (optional — comment out when using Neon)
# DATABASE_URL="file:./dev.db"

# Neon: use TWO strings from the Neon dashboard (Connect → copy each)
# Pooled (for the running app on Vercel) — hostname contains "-pooler"
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# Direct (for prisma migrate / db push) — hostname does NOT contain "-pooler"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# First-time setup (scripts/setup.js)
SETUP_EMAIL="you@example.com"
SETUP_PASSWORD="change-me-to-a-strong-password"
SETUP_NAME="Your Name"

# Add these same vars on Vercel (for /api/seed-account after deploy)
